Student Result System

from autogen import AssistantAgent

teacher = AssistantAgent(
    name="Teacher",
    llm_config=llm_config
)

marks_agent = AssistantAgent(
    name="MarksAgent",
    llm_config=llm_config,
    system_message="Calculate total marks."
)

grade_agent = AssistantAgent(
    name="GradeAgent",
    llm_config=llm_config,
    system_message="Assign grades."
)

teacher.register_nested_chats(
    [
        {
            "recipient": marks_agent,
            "message": "Calculate total marks for the student."
        },
        {
            "recipient": grade_agent,
            "message": "Assign grade based on total marks."
        }
    ]
)

